# StudFun 1.0: inställningar. Kopiera till .env och fyll i. .env läggs aldrig i git.
# Det som redan står i miljön, till exempel i tjänstens miljöfil, går före den här filen.

OPENAI_API_KEY=
# OPENAI_BASE=https://api.openai.com
# APP_ORIGIN=https://uni.studfun.se
# DATA_DIR=/var/lib/studfun-uni

# Modell och tänkande för varje AI-funktion. Tänkande: none, minimal, low, medium eller high.
# Lämna EFFORT tomt (EFFORT_X=) för en modell som inte tänker alls.

# Ett ord: förklara och ge exempel
MODEL_ORD=gpt-6-luna
EFFORT_ORD=none

# Förklara den här sidan. EFFORT_SIDA_IGEN gäller "Förklara på ett annat sätt" andra gången i rad på samma sida.
MODEL_SIDA=gpt-6-luna
EFFORT_SIDA=none
EFFORT_SIDA_IGEN=low

# Chatten med Tudi. Nano sorterar först varje fråga (MODEL_VALJ), så att Luna bara får det material som behövs.
# Ett dokument på högst MAX_TOKEN_HELA token skickas helt. Längre dokument skickas som sammanfattningar av avsnitten.
MODEL_VALJ=gpt-5-nano
EFFORT_VALJ=minimal
MODEL_CHATT=gpt-6-luna
EFFORT_CHATT=low
MAX_TOKEN_HELA=15000

# Sammanfattning vid uppladdning. gpt-5-nano tänker: sätt alltid minimal, annars kan den bli dyrare än Luna.
MODEL_SAMMANFATTNING=gpt-5-nano
EFFORT_SAMMANFATTNING=minimal

# Börja här
MODEL_BORJA=gpt-6-luna
EFFORT_BORJA=none

# Quiz och flashcards
MODEL_OVA=gpt-6-luna
EFFORT_OVA=low

# Rätta korta svar
MODEL_RATTA=gpt-6-luna
EFFORT_RATTA=low

# Vektorer för sökning. Byts modellen måste alla filer laddas upp igen.
MODEL_EMBED=text-embedding-3-small

# Tal till text, när studenten talar in en fråga
MODEL_TAL=gpt-4o-mini-transcribe

# Felsökning. AI_LOGG=1 skriver en rad per AI-anrop i serverns logg: modell, token, tid, och för chatten
# vad nano valde och vilket material Luna fick. Ingen text. AI_LOGG=fullt sparar dessutom hela anropen och
# svaren i DATA_DIR/ai-logg/ i 7 dagar. De innehåller studenternas frågor och material: bara för test.
# AI_LOGG=1

# Uppläsning. TTS_MOTOR=openai i dag. Piper kopplas in när det är provat på servern.
TTS_MOTOR=openai
MODEL_TTS=gpt-4o-mini-tts
